# MeOS feature modules: what can be left out of a build, what each one needs, and how a build picks them.
#
#   idf.py -DM5OS_MODULES="mp_camera,uvc"        build exactly these (plus whatever they need), nothing else optional
#   idf.py -DM5OS_MODULES=all                    every module this board can have
#   idf.py -DM5OS_DISABLE_MODULES="mjpeg,sl"     the defaults, minus these (and minus whatever needs them)
#   idf.py -DM5OS_PROFILE=small|medium|large    one of the published firmware sizes (see m5os_profile below)
#   (neither given)                              the defaults; the old per-feature switches (M5OS_MICROPYTHON,
#                                                M5OS_BLUETOOTH, M5OS_SL) still work
#
# Each module becomes a compile definition M5OS_MODULE_<NAME>=0|1 on every source file, so code guards itself with
# `#if M5OS_MODULE_<NAME>`; modules that have a sources directory of their own compile to nothing when off.
# docs/MODULES.md lists them and tools/m5os_modules.py prints the same table (and the dependency order) without a build.

set_property(GLOBAL PROPERTY M5OS_MODULE_NAMES "")

# m5os_module(<name> DESCRIPTION "..." [BOARDS tab5 ...] [DEFAULT ON|OFF] [OPTION <legacy cmake option>]
#             [DEPENDS a b ...] [DEPENDS_ANY x y ...])
#   DEPENDS      every one of them is needed
#   DEPENDS_ANY  at least one of them is needed (the first available one is pulled in when none was chosen)
function(m5os_module name)
    cmake_parse_arguments(ARG "" "DESCRIPTION;DEFAULT;OPTION" "BOARDS;DEPENDS;DEPENDS_ANY" ${ARGN})
    if(NOT ARG_BOARDS)
        set(ARG_BOARDS tab5 cores3 cardputer)
    endif()
    if(NOT DEFINED ARG_DEFAULT)
        set(ARG_DEFAULT ON)
    endif()
    set_property(GLOBAL APPEND PROPERTY M5OS_MODULE_NAMES ${name})
    set_property(GLOBAL PROPERTY M5OS_MODULE_${name}_DESCRIPTION "${ARG_DESCRIPTION}")
    set_property(GLOBAL PROPERTY M5OS_MODULE_${name}_BOARDS "${ARG_BOARDS}")
    set_property(GLOBAL PROPERTY M5OS_MODULE_${name}_DEFAULT "${ARG_DEFAULT}")
    set_property(GLOBAL PROPERTY M5OS_MODULE_${name}_OPTION "${ARG_OPTION}")
    set_property(GLOBAL PROPERTY M5OS_MODULE_${name}_DEPENDS "${ARG_DEPENDS}")
    set_property(GLOBAL PROPERTY M5OS_MODULE_${name}_DEPENDS_ANY "${ARG_DEPENDS_ANY}")
endfunction()

# The registry.  Everything not listed here (kernel, shell, USB host, storage, network, SSH, ...) is core for now.
m5os_module(camera      BOARDS tab5 DESCRIPTION "Built-in SC202CS camera: CSI/ISP driver, camera app, snap")
m5os_module(uvc         BOARDS tab5 DESCRIPTION "USB (UVC) camera, raw YUY2 frames"
                        )
m5os_module(mjpeg       BOARDS tab5 DESCRIPTION "Motion-JPEG from USB cameras: software JPEG decoder with reduced-size decoding"
                        DEPENDS uvc)
m5os_module(camsrc      BOARDS tab5 DESCRIPTION "One interface over the built-in and USB cameras"
                        DEPENDS_ANY camera uvc)
m5os_module(micropython BOARDS tab5 OPTION M5OS_MICROPYTHON DESCRIPTION "MicroPython interpreter and machine bindings")
m5os_module(mp_camera   BOARDS tab5 DESCRIPTION "MicroPython 'camera' module (cameras, images, display)"
                        DEPENDS micropython camsrc)
m5os_module(bluetooth   BOARDS tab5 OPTION M5OS_BLUETOOTH DEFAULT OFF DESCRIPTION "BLE HID host over ESP-Hosted (experimental)")
m5os_module(sl          OPTION M5OS_SL DESCRIPTION "SL animation")
m5os_module(fpga        BOARDS tab5 DEFAULT OFF DESCRIPTION "Dock jumper LINK v0: GPIO ID, echo, inversion and diagnostics")
m5os_module(fpga_parlio BOARDS tab5 DEFAULT OFF DEPENDS fpga DESCRIPTION "Native PARLIO/GDMA parallel transport and variable wire protocol")
m5os_module(fpga_gfx    BOARDS tab5 DEFAULT OFF DEPENDS fpga DESCRIPTION "Experimental Dock GFX: RGB565 drawing, readback verification and LCD demo")
m5os_module(gfxbench    BOARDS tab5 DEFAULT OFF DESCRIPTION "GPU LAB CPU graphics benchmark: polygon/Z, wireframe and six procedural scenes")
m5os_module(fpga_npu    BOARDS tab5 DEFAULT OFF DEPENDS fpga DESCRIPTION "NPU CPU conformance: checked INT8 MAC/dot, requantization, GEMM and convolution; physical contract pending")
m5os_module(fpga_diag   BOARDS tab5 DEFAULT OFF DEPENDS fpga_gfx fpga_npu gfxbench DESCRIPTION "Jumper diagnostic bundle and coverage inventory: LINK/GFX, CPU NPU conformance and GPU LAB")

# m5os_profile(<name> DESCRIPTION "..." MODULES a b ...)   a named selection; MODULES all = everything available
set_property(GLOBAL PROPERTY M5OS_PROFILE_NAMES "")
function(m5os_profile name)
    cmake_parse_arguments(ARG "" "DESCRIPTION" "MODULES" ${ARGN})
    set_property(GLOBAL APPEND PROPERTY M5OS_PROFILE_NAMES ${name})
    set_property(GLOBAL PROPERTY M5OS_PROFILE_${name}_DESCRIPTION "${ARG_DESCRIPTION}")
    set_property(GLOBAL PROPERTY M5OS_PROFILE_${name}_MODULES "${ARG_MODULES}")
endfunction()

# The three sizes published on the project's firmware page.
m5os_profile(small  DESCRIPTION "Core system only: shell, storage, USB host, network, SSH. No camera, MicroPython or extras."
                    MODULES)
m5os_profile(medium DESCRIPTION "Core plus the built-in camera, MicroPython with the camera module, and SL."
                    MODULES camera camsrc micropython mp_camera sl)
# BLE is left out of the published sizes: with it the image does not link (internal RAM overflows), so it needs a custom build.
m5os_profile(large  DESCRIPTION "Everything stable: also the USB camera with Motion-JPEG. The experimental BLE HID host is not included."
                    MODULES camera uvc mjpeg camsrc micropython mp_camera sl)

function(_m5os_in_list item list_var out_var)
    list(FIND ${list_var} "${item}" idx)
    if(idx EQUAL -1)
        set(${out_var} FALSE PARENT_SCOPE)
    else()
        set(${out_var} TRUE PARENT_SCOPE)
    endif()
endfunction()

# Decides the module set for this configure.  Sets M5OS_MODULE_<NAME> (1/0) and M5OS_MODULE_DEFINITIONS in the caller.
# Call after M5OS_USB_BACKEND is known and before the legacy option() lines run.
function(m5os_resolve_modules)
    get_property(all GLOBAL PROPERTY M5OS_MODULE_NAMES)
    set(board "$ENV{M5OS_BOARD}")
    if(NOT board)
        set(board cores3)
    endif()

    # availability on this board / configuration
    set(available)
    foreach(m IN LISTS all)
        get_property(boards GLOBAL PROPERTY M5OS_MODULE_${m}_BOARDS)
        _m5os_in_list("${board}" boards ok)
        if(ok AND m STREQUAL "uvc" AND NOT M5OS_USB_BACKEND STREQUAL "native_dma")
            set(ok FALSE)
        endif()
        if(ok)
            list(APPEND available ${m})
        endif()
    endforeach()

    string(REPLACE "," ";" requested "${M5OS_MODULES}")
    string(REPLACE "," ";" disabled "${M5OS_DISABLE_MODULES}")
    set(on)
    set(why)
    set(explicit FALSE)
    if(M5OS_PROFILE AND NOT requested)
        get_property(profiles GLOBAL PROPERTY M5OS_PROFILE_NAMES)
        _m5os_in_list("${M5OS_PROFILE}" profiles known_profile)
        if(NOT known_profile)
            message(FATAL_ERROR "M5OS_PROFILE: unknown profile '${M5OS_PROFILE}' (known: ${profiles})")
        endif()
        get_property(requested GLOBAL PROPERTY M5OS_PROFILE_${M5OS_PROFILE}_MODULES)
        message(STATUS "MeOS profile: ${M5OS_PROFILE}")
        set(explicit TRUE)
    elseif(requested AND NOT requested STREQUAL "default")
        set(explicit TRUE)
    endif()
    # Old switches this file forced on an earlier configure are not the user's choice: drop them.
    foreach(opt IN LISTS M5OS_FORCED_OPTIONS)
        unset(${opt} CACHE)
    endforeach()
    set(M5OS_FORCED_OPTIONS "" CACHE INTERNAL "Legacy options set by m5os_resolve_modules")
    set(forced)

    if(explicit)
        # explicit selection: the listed modules and, transitively, what they need
        if(requested STREQUAL "all")
            set(requested ${available})
        endif()
        foreach(m IN LISTS requested)
            _m5os_in_list("${m}" all known)
            _m5os_in_list("${m}" available avail)
            if(NOT known)
                message(FATAL_ERROR "M5OS_MODULES: unknown module '${m}' (known: ${all})")
            endif()
            if(NOT avail)
                message(FATAL_ERROR "M5OS_MODULES: module '${m}' is not available for board '${board}' with this configuration")
            endif()
            list(APPEND on ${m})
            set(why_${m} "selected")
        endforeach()
        set(changed TRUE)
        while(changed)
            set(changed FALSE)
            foreach(m IN LISTS on)
                get_property(deps GLOBAL PROPERTY M5OS_MODULE_${m}_DEPENDS)
                foreach(d IN LISTS deps)
                    _m5os_in_list("${d}" on have)
                    if(NOT have)
                        _m5os_in_list("${d}" available avail)
                        if(NOT avail)
                            message(FATAL_ERROR "Module '${m}' needs '${d}', which is not available for board '${board}'")
                        endif()
                        list(APPEND on ${d})
                        set(why_${d} "needed by ${m}")
                        set(changed TRUE)
                    endif()
                endforeach()
                get_property(any GLOBAL PROPERTY M5OS_MODULE_${m}_DEPENDS_ANY)
                if(any)
                    set(satisfied FALSE)
                    foreach(d IN LISTS any)
                        _m5os_in_list("${d}" on have)
                        if(have)
                            set(satisfied TRUE)
                        endif()
                    endforeach()
                    if(NOT satisfied)
                        foreach(d IN LISTS any)
                            _m5os_in_list("${d}" available avail)
                            if(avail AND NOT satisfied)
                                list(APPEND on ${d})
                                set(why_${d} "needed by ${m}")
                                set(satisfied TRUE)
                                set(changed TRUE)
                            endif()
                        endforeach()
                        if(NOT satisfied)
                            message(FATAL_ERROR "Module '${m}' needs one of: ${any}")
                        endif()
                    endif()
                endif()
            endforeach()
        endwhile()
    else()
        # defaults, honouring the old per-feature switches when the user gave one
        foreach(m IN LISTS available)
            get_property(def GLOBAL PROPERTY M5OS_MODULE_${m}_DEFAULT)
            get_property(opt GLOBAL PROPERTY M5OS_MODULE_${m}_OPTION)
            set(enabled ${def})
            set(reason "default")
            if(opt AND DEFINED CACHE{${opt}})
                set(enabled ${${opt}})
                set(reason "${opt}")
            endif()
            _m5os_in_list("${m}" disabled off)
            if(off)
                set(enabled OFF)
                set(reason "M5OS_DISABLE_MODULES")
            endif()
            if(enabled)
                list(APPEND on ${m})
                set(why_${m} "${reason}")
            endif()
        endforeach()
        # drop what lost a dependency
        set(changed TRUE)
        while(changed)
            set(changed FALSE)
            foreach(m IN LISTS on)
                set(keep TRUE)
                get_property(deps GLOBAL PROPERTY M5OS_MODULE_${m}_DEPENDS)
                foreach(d IN LISTS deps)
                    _m5os_in_list("${d}" on have)
                    if(NOT have)
                        set(keep FALSE)
                        set(reason "needs ${d}")
                    endif()
                endforeach()
                get_property(any GLOBAL PROPERTY M5OS_MODULE_${m}_DEPENDS_ANY)
                if(any)
                    set(satisfied FALSE)
                    foreach(d IN LISTS any)
                        _m5os_in_list("${d}" on have)
                        if(have)
                            set(satisfied TRUE)
                        endif()
                    endforeach()
                    if(NOT satisfied)
                        set(keep FALSE)
                        set(reason "needs one of ${any}")
                    endif()
                endif()
                if(NOT keep)
                    list(REMOVE_ITEM on ${m})
                    set(why_${m} "off: ${reason}")
                    set(changed TRUE)
                    break()
                endif()
            endforeach()
        endwhile()
    endif()

    # report and export
    set(defs)
    message(STATUS "MeOS modules (board ${board}):")
    foreach(m IN LISTS all)
        string(TOUPPER "${m}" upper)
        _m5os_in_list("${m}" on enabled)
        _m5os_in_list("${m}" available avail)
        if(enabled)
            set(value 1)
            set(state "on ")
            set(note "${why_${m}}")
        else()
            set(value 0)
            set(state "off")
            if(NOT avail)
                set(note "not available for this board/configuration")
            elseif(why_${m})
                set(note "${why_${m}}")
            else()
                set(note "not selected")
            endif()
        endif()
        message(STATUS "  [${state}] ${m}  (${note})")
        set(M5OS_MODULE_${upper} ${value} PARENT_SCOPE)
        list(APPEND defs "M5OS_MODULE_${upper}=${value}")
        # keep the old switches in step so their cmake files build exactly what was decided
        get_property(opt GLOBAL PROPERTY M5OS_MODULE_${m}_OPTION)
        if(explicit AND opt AND avail)
            if(enabled)
                set(${opt} ON CACHE BOOL "Set by M5OS_MODULES" FORCE)
            else()
                set(${opt} OFF CACHE BOOL "Set by M5OS_MODULES" FORCE)
            endif()
            list(APPEND forced ${opt})
        endif()
    endforeach()
    set(M5OS_FORCED_OPTIONS "${forced}" CACHE INTERNAL "Legacy options set by m5os_resolve_modules")
    set(M5OS_MODULE_DEFINITIONS ${defs} PARENT_SCOPE)
endfunction()
